# Copy to .env.local and fill in the services you want (each one is optional:
# a service without its keys is simply not offered). They are read when the
# site is built (npm run dev / npm run build).

# Google Drive — Google Cloud console › APIs & Services:
#   1. Enable "Google Picker API" and "Google Drive API".
#   2. Credentials › Create credentials › OAuth client ID › Web application.
#      Authorized JavaScript origins: http://localhost:3000 (and your site's origin).
#   3. Credentials › Create credentials › API key (restrict it to the Picker API and your origins).
#   4. The project number (Dashboard) is the app id.
#   OAuth consent screen: scope https://www.googleapis.com/auth/drive.file only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# OneDrive — Microsoft Entra admin center › App registrations › New registration:
#   Supported account types: personal and work accounts.
#   Redirect URI (Single-page application): http://localhost:3000/compare/ (and your site's).
NEXT_PUBLIC_ONEDRIVE_CLIENT_ID=

# Dropbox — dropbox.com/developers/apps › Create app (Scoped access, Full Dropbox or App folder):
#   Settings › Chooser / Saver / Embedder domains: localhost (and your site's domain).
NEXT_PUBLIC_DROPBOX_APP_KEY=

# Transcription on the server (optional) — server/transcribe, a small Go service that runs whisper.cpp:
#   brew install whisper-cpp   (or build whisper.cpp; set WHISPER_BIN to its whisper-cli)
#   npm run server:model       (downloads ggml-base, 142 MB)
#   npm run server             (listens on 127.0.0.1:8787)
# The site's /api/transcribe passes recordings on to it; read when the Next server starts, so
# changing it needs a restart, not a build. Readers are asked before any recording is sent;
# the service keeps nothing.
# (Unset, it is http://127.0.0.1:8787, where npm run server listens.)
TRANSCRIBE_URL=
