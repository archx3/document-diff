{
  "name": "document-diff",
  "private": true,
  "version": "1.0.0",
  "description": "Collate: compare two Word or Google Docs documents side by side and copy changes between them, entirely in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build && node scripts/inline-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures": "python3 scripts/make_fixtures.py"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.2",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
